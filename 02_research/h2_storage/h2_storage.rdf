            <dcterms:URI>
                <rdf:value>https://linkinghub.elsevier.com/retrieve/pii/S1364032122006311</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2025-09-25 17:03:27</dcterms:dateSubmitted>
        <bib:pages>112743</bib:pages>
    </bib:Article>
